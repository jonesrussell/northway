{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runnable personal local news profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "enabled",
    "use_scope",
    "provider_export_allowed",
    "commercial_use_approved",
    "approval_record",
    "activation_record",
    "feeds",
    "sources",
    "excluded"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "const": "personal-local-v1"
    },
    "enabled": {
      "const": true
    },
    "use_scope": {
      "const": "personal_metadata_feed_aggregation"
    },
    "provider_export_allowed": {
      "const": false
    },
    "commercial_use_approved": {
      "const": false
    },
    "approval_record": {
      "const": "docs/source-approval-2026-08-31.md"
    },
    "feeds": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "categories",
          "publisher_cap",
          "use_context"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "development",
                "entertainment",
                "canada",
                "world"
              ]
            }
          },
          "publisher_cap": {
            "const": 2
          },
          "use_context": {
            "const": false
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "feed_url",
          "feed_ids",
          "interval_seconds",
          "max_bytes",
          "personal_use_basis",
          "publisher_group",
          "categories"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "feed_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "feed_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "interval_seconds": {
            "const": 14400
          },
          "max_bytes": {
            "const": 2097152
          },
          "personal_use_basis": {
            "enum": [
              "publisher_summary_link",
              "owner_directed_official_feed"
            ]
          },
          "publisher_group": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "enum": [
                "development",
                "entertainment",
                "canada",
                "world"
              ]
            }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalogue_id",
          "reason"
        ],
        "properties": {
          "catalogue_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "activation_record": {
      "const": "docs/source-activation-2026-08-31.md"
    }
  }
}
