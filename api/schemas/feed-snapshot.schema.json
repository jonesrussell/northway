{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feed-snapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "feed_id": {
      "type": "string",
      "format": "uuid"
    },
    "feed_revision": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "ai",
            "deterministic_fallback"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "mode",
        "version"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "stale"
          ]
        },
        "sources_selected": {
          "type": "integer",
          "minimum": 1
        },
        "sources_current": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "sources_selected",
        "sources_current"
      ]
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "article_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https?://"
          },
          "source_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "why_relevant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_url": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 2048,
                  "pattern": "^https?://"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1500
                },
                "basis": {
                  "enum": [
                    "feed_excerpt",
                    "web_search_excerpt",
                    "article_excerpt",
                    "source_metadata"
                  ]
                }
              },
              "required": [
                "source_url",
                "text",
                "basis"
              ]
            }
          }
        },
        "required": [
          "article_id",
          "title",
          "url",
          "source_name",
          "published_at",
          "observed_at",
          "summary",
          "why_relevant",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "request_id",
    "snapshot_id",
    "feed_id",
    "feed_revision",
    "generated_at",
    "expires_at",
    "ranking",
    "coverage",
    "warnings",
    "items"
  ]
}
