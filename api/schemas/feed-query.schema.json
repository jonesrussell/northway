{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feed-query",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "feed_id": {
      "type": "string",
      "format": "uuid"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "technologies": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "focus": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "required": [
        "intent",
        "technologies"
      ]
    },
    "max_age_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 720
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "required": [
    "feed_id",
    "context",
    "max_age_hours",
    "limit"
  ]
}
