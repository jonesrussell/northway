{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "problem",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "invalid_request",
        "unauthorized",
        "forbidden",
        "not_found",
        "conflict",
        "in_progress",
        "rate_limited",
        "unavailable"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "message",
    "request_id",
    "retryable"
  ]
}
