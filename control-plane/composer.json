{
  "name": "northcloud/control-plane",
  "description": "NorthCloud invitation beta customer application",
  "type": "project",
  "require": {
    "php": ">=8.5",
    "ext-pdo_sqlite": "*",
    "ext-sodium": "*",
    "ext-sqlite3": "*",
    "symfony/dotenv": "^8.0",
    "waaseyaa/framework": "0.1.0-alpha.302"
  },
  "require-dev": {"phpunit/phpunit": "^13.0"},
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "extra": {"waaseyaa": {"providers": ["App\\Provider\\AppServiceProvider"]}},
  "config": {"sort-packages": true, "allow-plugins": false},
  "minimum-stability": "dev",
  "prefer-stable": true
}
